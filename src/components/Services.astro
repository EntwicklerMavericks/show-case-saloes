---
import type { Theme, ServiceIconType } from '../data/themes';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;

function renderInitialIcon(icon: ServiceIconType) {
  switch (icon) {
    case 'scissors':
      return `
        <svg class="w-8 h-8 sm:w-9 sm:h-9 stroke-current" viewBox="0 0 32 32" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11.5" cy="8.5" r="2.8"></circle>
          <circle cx="20.5" cy="8.5" r="2.8"></circle>
          <line x1="11.5" y1="11.3" x2="16" y2="16.5"></line>
          <line x1="20.5" y1="11.3" x2="16" y2="16.5"></line>
          <circle cx="16" cy="16.5" r="0.6" fill="currentColor"></circle>
          <line x1="16" y1="16.5" x2="11.5" y2="25"></line>
          <line x1="16" y1="16.5" x2="20.5" y2="25"></line>
          <line x1="4.5" y1="16.5" x2="8.5" y2="16.5"></line>
          <line x1="23.5" y1="16.5" x2="27.5" y2="16.5"></line>
        </svg>
      `;
    case 'brush':
      return `
        <svg class="w-8 h-8 sm:w-9 sm:h-9 stroke-current" viewBox="0 0 32 32" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <g transform="rotate(45, 16, 16)">
            <line x1="16" y1="28.5" x2="16" y2="17.5" stroke-width="1.5" stroke-linecap="round"></line>
            <rect x="12" y="14.5" width="8" height="3" rx="0.4"></rect>
            <path d="M12.5 14.5 L13 6.5 H19 L19.5 14.5 Z"></path>
            <line x1="14.5" y1="14.5" x2="14.7" y2="6.5" stroke-width="0.9"></line>
            <line x1="16" y1="14.5" x2="16" y2="6.5" stroke-width="0.9"></line>
            <line x1="17.5" y1="14.5" x2="17.3" y2="6.5" stroke-width="0.9"></line>
          </g>
        </svg>
      `;
    case 'sparkles':
      return `
        <svg class="w-8 h-8 sm:w-9 sm:h-9 stroke-current" viewBox="0 0 32 32" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M 18.5 5.5 C 13.5 9, 12 13, 15.5 16 C 19 19, 17 23, 12 26.5"></path>
          <path d="M 21.5 5.5 C 16.5 9, 15 13, 18.5 16 C 22 19, 20 23, 15 26.5"></path>
          <path d="M 24.5 5.5 C 19.5 9, 18 13, 21.5 16 C 25 19, 23 23, 18 26.5"></path>
        </svg>
      `;
    case 'spa':
      return `
        <svg class="w-8 h-8 sm:w-9 sm:h-9 stroke-current" viewBox="0 0 32 32" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12.5" cy="24" r="2.5"></circle>
          <circle cx="19.5" cy="24" r="2.5"></circle>
          <line x1="12.5" y1="21.5" x2="15.2" y2="17"></line>
          <line x1="19.5" y1="21.5" x2="16.8" y2="17"></line>
          <circle cx="16" cy="17" r="0.5" fill="currentColor"></circle>
          <path d="M 15.2 17 C 14.8 12.5, 14.2 9, 16 5.5"></path>
          <path d="M 16.8 17 C 17.2 12.5, 18 9, 20.2 6"></path>
        </svg>
      `;
    case 'comb':
      return `
        <svg class="w-8 h-8 sm:w-9 sm:h-9 stroke-current" viewBox="0 0 32 32" fill="none" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <g transform="rotate(45, 16, 16)">
            <line x1="16" y1="28.5" x2="16" y2="18.5" stroke-width="1.5" stroke-linecap="round"></line>
            <rect x="12" y="5.5" width="8" height="13" rx="2.8"></rect>
            <line x1="14" y1="7.8" x2="14" y2="16" stroke-width="0.8" stroke-dasharray="1 1.8"></line>
            <line x1="16" y1="7.2" x2="16" y2="16.8" stroke-width="0.8" stroke-dasharray="1 1.8"></line>
            <line x1="18" y1="7.8" x2="18" y2="16" stroke-width="0.8" stroke-dasharray="1 1.8"></line>
          </g>
        </svg>
      `;
  }
}
---

<section id="servicos" class="bg-theme-dark border-t border-b border-theme-border-dark py-14 sm:py-20 transition-colors duration-300">
  <div class="w-full max-w-[1720px] mx-auto px-4 sm:px-8 lg:px-12 xl:px-16">
    <!-- Faixa Horizontal Esticada com os 5 Serviços Bem Distribuídos e Divisores Verticais -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 items-stretch justify-items-stretch"
      data-theme-collection="services"
    >
      {theme.services.items.map((item, index) => (
        <div
          class="relative flex flex-col items-center text-center group cursor-pointer px-4 sm:px-6 py-6 sm:py-5 transition-colors duration-200"
          data-theme-item-index={index}
        >
          <!-- Ícone Delicado Minimalista em Tom Accent Dourado/Champanhe -->
          <div
            class="text-theme-accent mb-4 transition-transform duration-300 group-hover:scale-110"
            data-theme-item-field="icon"
            set:html={renderInitialIcon(item.icon)}
          />

          <!-- Título do Serviço em Caixa Alta com Espaçamento Amplo -->
          <h2
            class="font-sans text-xs sm:text-sm font-semibold uppercase tracking-[0.25em] text-theme-on-dark mb-2.5 group-hover:text-theme-accent transition-colors duration-200"
            data-theme-item-field="title"
          >
            {item.title}
          </h2>

          <!-- Subtítulo Curto Descritivo em 2 Linhas Balanceadas -->
          <p
            class="font-sans text-xs sm:text-[13px] text-theme-on-dark-muted font-light leading-relaxed max-w-[210px]"
            data-theme-item-field="subtitle"
          >
            <span class="block" data-theme-item-field="line1">{item.line1 || item.subtitle}</span>
            {item.line2 && <span class="block" data-theme-item-field="line2">{item.line2}</span>}
          </p>

          <!-- Linha divisória vertical mais fina e menor (desktop: centrada, h-12 xl:h-14, ultrafina) -->
          {index < theme.services.items.length - 1 && (
            <div
              class="hidden lg:block absolute right-0 top-1/2 -translate-y-1/2 h-12 xl:h-14 w-[1px] bg-[#383838] pointer-events-none"
              style="background-color: var(--color-border-dark, #383838);"
              aria-hidden="true"
            />
          )}

          <!-- Linha divisória sutil para mobile -->
          {index < theme.services.items.length - 1 && (
            <div
              class="block sm:hidden w-16 h-[1px] bg-[#2a2a2a] mt-6 mx-auto pointer-events-none"
              aria-hidden="true"
            />
          )}
        </div>
      ))}
    </div>
  </div>
</section>
