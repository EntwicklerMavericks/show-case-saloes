---
import type { Theme } from '../data/themes';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---

<section id="galeria" class="bg-theme-dark text-theme-on-dark py-10 sm:py-12 lg:py-16 transition-colors duration-300">
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
      
      <!-- Coluna da Esquerda: Textos e Botão de Ação -->
      <div class="lg:col-span-4 xl:col-span-3">
        <p class="font-sans text-xs sm:text-sm tracking-[0.25em] uppercase text-theme-on-dark-muted mb-3 font-medium" data-theme-field="gallery.overline">
          {theme.gallery.overline}
        </p>

        <h2 class="font-heading text-3xl sm:text-4xl xl:text-5xl font-normal text-theme-on-dark tracking-tight leading-tight mb-6">
          <span data-theme-field="gallery.title">{theme.gallery.title}</span>
        </h2>

        <p class="font-sans text-sm sm:text-base text-theme-on-dark-muted font-light leading-relaxed mb-8 max-w-sm" data-theme-field="gallery.description">
          {theme.gallery.description}
        </p>

        <a
          href={theme.gallery.ctaHref}
          data-theme-field="gallery.ctaText"
          class="inline-flex w-full sm:w-auto justify-center items-center gap-2.5 px-6 py-3.5 border border-neutral-700 hover:border-theme-on-dark text-theme-on-dark font-sans text-xs font-semibold uppercase tracking-wider rounded-theme-btn transition-colors duration-200 group focus:outline-none"
        >
          <span>{theme.gallery.ctaText}</span>
          <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Coluna da Direita: Grade com 4 Fotografias Verticais Esticadas -->
      <div class="lg:col-span-8 xl:col-span-9">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 sm:gap-6" data-theme-collection="gallery">
          {theme.gallery.items.map((item, index) => (
            <div
              class="relative aspect-[3/4] sm:aspect-[9/13] rounded-lg overflow-hidden bg-neutral-900 shadow-lg group cursor-pointer"
              data-theme-item-index={index}
            >
              <img
                src={item.url}
                alt={item.alt}
                data-theme-item-field="image"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              />
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
