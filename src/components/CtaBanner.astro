---
import type { Theme } from '../data/themes';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---

<section class="relative bg-theme-dark text-theme-on-dark py-12 sm:py-14 lg:py-16 overflow-hidden border-t border-theme-border-dark transition-colors duration-300">
  <!-- Imagem de Fundo Sutilmente Escurecida -->
  <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
    <img
      src={theme.about.imageUrl}
      alt="Fundo decorativo do salão"
      class="w-full h-full object-cover object-center filter blur-sm"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-theme-dark/85"></div>
  </div>

  <div class="relative z-10 w-full max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10 text-center flex flex-col items-center">
    <!-- Overline -->
    <p class="font-sans text-xs sm:text-sm tracking-[0.25em] uppercase text-theme-on-dark-muted mb-4 font-medium" data-theme-field="ctaBanner.overline">
      {theme.ctaBanner.overline}
    </p>

    <!-- Título de Chamada -->
    <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-normal text-theme-on-dark tracking-tight mb-8">
      <span data-theme-field="ctaBanner.title">{theme.ctaBanner.title}</span>
    </h2>

    <!-- Botão Principal Nude / Rosé Gold -->
    <a
      href={theme.ctaBanner.ctaHref}
      data-theme-field="ctaBanner.ctaText"
      class="inline-flex items-center gap-3 px-8 py-4 bg-theme-accent hover:bg-theme-accent-hover text-theme-accent-text font-sans text-xs font-semibold uppercase tracking-wider rounded-theme-btn transition-all duration-200 shadow-lg group focus:outline-none"
    >
      <span>{theme.ctaBanner.ctaText}</span>
      <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</section>
