---
import type { Theme } from '../data/themes';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---

<section id="inicio" class="relative bg-theme-dark overflow-hidden transition-colors duration-300 min-h-[580px] sm:min-h-[640px] lg:min-h-[700px] xl:min-h-[760px] flex items-center">
  
  <!-- Imagem da Modelo em Full-Bleed até a Borda Direita da Tela (Sem Faixa Preta) -->
  <div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-[50vw] xl:w-[52vw] w-full h-[480px] sm:h-[560px] lg:h-full z-0 select-none overflow-hidden order-2 lg:order-none">
    <img
      src={theme.hero.heroImageUrl}
      alt={theme.hero.heroImageAlt}
      data-theme-field="hero.heroImageUrl"
      data-theme-target="src"
      loading="eager"
      fetchpriority="high"
      class="w-full h-full object-cover object-top lg:object-center"
    />
    <!-- Gradiente de Fusão para a Esquerda (onde fica o bloco de texto) -->
    <div class="hidden lg:block absolute inset-y-0 left-0 w-64 xl:w-80 bg-gradient-to-r from-theme-dark via-theme-dark/80 to-transparent pointer-events-none"></div>
    <!-- Gradiente de Fusão na Base -->
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-theme-dark via-theme-dark/70 to-transparent pointer-events-none"></div>
    <!-- Gradiente de Fusão no Topo -->
    <div class="absolute inset-x-0 top-0 h-16 bg-gradient-to-b from-theme-dark/40 to-transparent pointer-events-none"></div>
  </div>

  <!-- Conteúdo Textual do Hero Perfeitamente Alinhado ao Restante do Site -->
  <div class="relative z-10 w-full max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10 py-10 sm:py-14 lg:py-20 pointer-events-none order-1 lg:order-none">
    <div class="max-w-2xl lg:max-w-xl xl:max-w-2xl pointer-events-auto">
      <!-- Subtítulo / Overline -->
      <p class="font-sans text-xs sm:text-sm tracking-[0.25em] uppercase text-theme-on-dark-muted mb-5 font-medium" data-theme-field="hero.overline">
        {theme.hero.overline}
      </p>

      <!-- Título Principal Monumental em Serif Clássico -->
      <h1 class="font-heading text-4xl sm:text-6xl lg:text-6xl xl:text-7xl font-normal text-theme-on-dark tracking-tight leading-[1.1] mb-6">
        <span data-theme-field="hero.title">{theme.hero.title}</span>
      </h1>

      <!-- Descrição Orientada ao Cuidado e Benefício -->
      <p class="font-sans text-sm sm:text-base lg:text-lg text-theme-on-dark-muted font-light leading-relaxed mb-10 max-w-xl" data-theme-field="hero.description">
        {theme.hero.description}
      </p>

      <!-- Botão CTA Principal Fiel à Referência -->
      <a
        href={theme.hero.ctaHref}
        data-theme-field="hero.ctaText"
        class="inline-flex items-center gap-3 px-8 py-4 bg-theme-accent hover:bg-theme-accent-hover text-theme-accent-text font-sans text-xs font-semibold uppercase tracking-wider rounded-theme-btn transition-all duration-200 shadow-md group focus:outline-none"
      >
        <span>{theme.hero.ctaText}</span>
        <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

</section>
