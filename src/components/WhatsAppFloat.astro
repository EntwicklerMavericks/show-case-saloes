---
interface Props {
  phoneNumber?: string;
  displayPhone?: string;
  defaultMessage?: string;
}

const {
  phoneNumber = '5511933565640',
  displayPhone = '(11) 93356-5640',
  defaultMessage = 'Olá! Gostaria de agendar um horário no salão.',
} = Astro.props;

const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(defaultMessage)}`;
---

<!-- Botão Flutuante Oficial do WhatsApp com Paleta do Salão -->
<div id="whatsapp-float-root" class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 font-sans">
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    id="whatsapp-float-btn"
    class="group relative flex items-center gap-2.5 sm:gap-3 p-2.5 sm:px-4 sm:py-3 bg-neutral-900/95 hover:bg-black text-theme-accent border border-theme-accent/40 rounded-full shadow-2xl backdrop-blur-md transition-all duration-300 hover:scale-105 hover:border-theme-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-theme-accent"
    aria-label={`Falar no WhatsApp: ${displayPhone}`}
    title={`Falar no WhatsApp: ${displayPhone}`}
  >
    <!-- Ícone Oficial do WhatsApp na Cor da Paleta da Landing Page -->
    <div class="w-9 h-9 sm:w-8 sm:h-8 rounded-full bg-theme-accent/15 text-theme-accent flex items-center justify-center border border-theme-accent/30 group-hover:scale-110 group-hover:bg-theme-accent/25 transition-all flex-shrink-0">
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7 8.5 7 9.71C7 10.93 7.89 12.1 8.01 12.27C8.14 12.44 9.76 14.94 12.25 16C12.84 16.27 13.3 16.42 13.66 16.53C14.25 16.72 14.79 16.69 15.22 16.63C15.7 16.56 16.68 16.03 16.89 15.45C17.1 14.87 17.1 14.38 17.04 14.27C16.97 14.17 16.81 14.11 16.56 13.99C16.32 13.86 15.12 13.27 14.9 13.19C14.67 13.11 14.51 13.07 14.35 13.31C14.19 13.55 13.73 14.11 13.58 14.27C13.44 14.44 13.3 14.46 13.06 14.34C12.82 14.21 11.8 13.88 10.6 12.81C9.65 11.97 9.02 10.93 8.89 10.69C8.75 10.45 8.88 10.31 9 10.19C9.11 10.08 9.24 9.9 9.36 9.76C9.48 9.62 9.52 9.52 9.6 9.36C9.68 9.2 9.64 9.06 9.58 8.94C9.52 8.82 9.04 7.64 8.84 7.16C8.65 6.7 8.45 6.76 8.3 6.75L7.84 6.75C7.68 6.75 7.42 6.81 7.2 7.05L8.53 7.33Z"/>
      </svg>
    </div>

    <!-- Rótulo Descritivo no Desktop -->
    <div class="text-left hidden sm:flex flex-col pr-1">
      <span class="text-[10px] uppercase tracking-widest text-neutral-400 font-semibold leading-tight">
        Atendimento
      </span>
      <span class="text-xs font-bold text-neutral-100 tracking-wide group-hover:text-theme-accent transition-colors">
        Falar no WhatsApp
      </span>
    </div>

    <!-- Indicador de Pulso Online na Cor da Paleta -->
    <span class="w-2.5 h-2.5 rounded-full bg-theme-accent animate-ping absolute -top-0.5 -right-0.5 pointer-events-none opacity-80"></span>
    <span class="w-2.5 h-2.5 rounded-full bg-theme-accent absolute -top-0.5 -right-0.5 pointer-events-none"></span>
  </a>
</div>
