---
import type { Theme } from '../data/themes';

interface Props {
  theme: Theme;
}

const { theme } = Astro.props;
---

<section id="depoimentos" class="bg-theme-light text-theme-on-light py-10 sm:py-12 lg:py-16 transition-colors duration-300 overflow-hidden">
  <!-- Cabeçalho Alinhado ao Padrão de Todas as Seções -->
  <div class="w-full max-w-[1800px] mx-auto px-4 sm:px-6 lg:px-8 xl:px-10 mb-8 sm:mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
    <div>
      <p class="font-sans text-xs sm:text-sm tracking-[0.25em] uppercase text-theme-on-light-muted mb-2.5 font-semibold" data-theme-field="testimonials.overline">
        {theme.testimonials.overline}
      </p>

      <h2 class="font-heading text-3xl sm:text-4xl xl:text-5xl font-normal text-theme-on-light tracking-tight leading-tight">
        <span data-theme-field="testimonials.title">{theme.testimonials.title}</span>
      </h2>
    </div>

    <!-- Indicador de Avaliação Máxima Social Proof -->
    <div class="flex items-center gap-2.5 bg-theme-card-light px-4 py-2 rounded-full border border-theme-border-light/70 shadow-xs self-start md:self-auto">
      <div class="flex items-center gap-0.5 text-amber-500 text-sm" aria-label="Classificação 5 estrelas">
        <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
      </div>
      <span class="font-sans text-xs text-theme-on-light font-medium">
        5.0 • Mais de 500 avaliações
      </span>
    </div>
  </div>

  <!-- Carrossel Linear Contínuo Sem Pausas (Infinite Marquee) -->
  <div
    class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_4%,black_96%,transparent)] group"
    data-theme-collection="testimonials"
  >
    <div class="marquee-track flex gap-6 w-max animate-marquee py-2 cursor-grab active:cursor-grabbing will-change-transform">
      <!-- Primeiro Bloco (10 cards de comentários) -->
      {theme.testimonials.items.map((item, index) => (
        <div
          class="w-[290px] sm:w-[340px] lg:w-[370px] bg-theme-card-light p-6 sm:p-7 rounded-xl border border-theme-border-light/80 shadow-xs flex flex-col justify-between flex-shrink-0 transition-transform duration-300 hover:-translate-y-1.5 hover:shadow-md"
          data-theme-item-index={index}
        >
          <div>
            <!-- Aspas Estilizadas em Destaque -->
            <span class="font-heading text-3xl text-theme-on-light font-normal leading-none block mb-3 select-none opacity-80">
              “
            </span>

            <!-- Citação da Cliente -->
            <p
              class="font-sans text-xs sm:text-[13px] text-theme-on-light-muted font-light leading-relaxed mb-6 min-h-[56px] line-clamp-3 select-none"
              data-theme-item-field="quote"
            >
              “{item.quote}”
            </p>
          </div>

          <!-- Autor e 5 Estrelas -->
          <div class="pt-4 border-t border-theme-border-light/50 flex items-center justify-between">
            <p
              class="font-sans text-xs sm:text-[13px] font-medium text-theme-on-light"
              data-theme-item-field="clientName"
            >
              {item.clientName}
            </p>

            <div class="flex items-center gap-0.5 text-amber-500 text-xs select-none" aria-label="Avaliação de 5 estrelas">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
          </div>
        </div>
      ))}

      <!-- Segundo Bloco Idêntico para Loop Contínuo Infinito Sem Saltos -->
      {theme.testimonials.items.map((item, index) => (
        <div
          class="w-[290px] sm:w-[340px] lg:w-[370px] bg-theme-card-light p-6 sm:p-7 rounded-xl border border-theme-border-light/80 shadow-xs flex flex-col justify-between flex-shrink-0 transition-transform duration-300 hover:-translate-y-1.5 hover:shadow-md"
          data-theme-item-index={index}
          aria-hidden="true"
        >
          <div>
            <!-- Aspas Estilizadas em Destaque -->
            <span class="font-heading text-3xl text-theme-on-light font-normal leading-none block mb-3 select-none opacity-80">
              “
            </span>

            <!-- Citação da Cliente -->
            <p
              class="font-sans text-xs sm:text-[13px] text-theme-on-light-muted font-light leading-relaxed mb-6 min-h-[56px] line-clamp-3 select-none"
              data-theme-item-field="quote"
            >
              “{item.quote}”
            </p>
          </div>

          <!-- Autor e 5 Estrelas -->
          <div class="pt-4 border-t border-theme-border-light/50 flex items-center justify-between">
            <p
              class="font-sans text-xs sm:text-[13px] font-medium text-theme-on-light"
              data-theme-item-field="clientName"
            >
              {item.clientName}
            </p>

            <div class="flex items-center gap-0.5 text-amber-500 text-xs select-none" aria-label="Avaliação de 5 estrelas">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-marquee {
    display: flex;
    width: max-content;
    animation: marquee 45s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .animate-marquee {
      animation-play-state: paused;
    }
  }
</style>
